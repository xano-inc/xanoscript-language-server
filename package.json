{
  "name": "@xano/xanoscript-language-server",
  "version": "12.22.0",
  "description": "Language Server Protocol implementation for XanoScript, the language of Xano backends",
  "keywords": [
    "xano",
    "xanoscript",
    "language-server",
    "lsp",
    "chevrotain"
  ],
  "type": "module",
  "main": "server.js",
  "files": [
    "server.js",
    "connection.js",
    "documents.js",
    "utils.js",
    "language-server-worker.js",
    "logic-assistant-script.js",
    "profile-parser.js",
    "cache/",
    "embedded/",
    "lexer/**/*.js",
    "onCheckError/",
    "onCompletion/contentAssist.js",
    "onCompletion/onCompletion.js",
    "onCompletion/policyCompletion.js",
    "onDefinition/onDefinition.js",
    "onDidChangeContent/",
    "onHover/",
    "onSemanticCheck/",
    "parser/**/*.js",
    "workspace/",
    "!**/*.spec.js",
    "!**/tests/",
    "!**/valid_sources/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xano-inc/xanoscript-language-server.git"
  },
  "author": "Xano <support@xano.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/xano-inc/xanoscript-language-server/issues"
  },
  "homepage": "https://github.com/xano-inc/xanoscript-language-server#readme",
  "dependencies": {
    "chevrotain": "^11.0.3",
    "lodash-es": "^4.17.21",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "c8": "^11.0.0",
    "chai": "^5.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "mocha": "^11.1.0"
  }
}
